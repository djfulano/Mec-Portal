server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }
    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    authorize {
        preprocess
        chap
        mschap
        suffix
        sql

        # Contador diário - calcula tempo usado hoje
        dailycounter

        # O dailycounter já ajusta Session-Timeout automaticamente
        # e rejeita quando Max-Daily-Session é excedido

        # Expiration check
        expiration
        logintime

        pap
    }

    authenticate {
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
        Auth-Type PAP {
            pap
        }
    }

    preacct {
        preprocess
        acct_unique
        suffix
        files
    }

    accounting {
        sql
        exec
        attr_filter.accounting_response
    }

    # Sessao - verifica Simultaneous-Use via SQL
    session {
        sql
    }

    post-auth {
        sql
        exec
        remove_reply_message_if_eap

        Post-Auth-Type REJECT {
            attr_filter.access_reject
            sql
            update reply {
                Reply-Message := "Acesso negado"
            }
        }
    }

    pre-proxy {
    }

    post-proxy {
    }
}
